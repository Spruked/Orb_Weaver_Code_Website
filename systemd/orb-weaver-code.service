[Unit]
Description=Orb Weaver Code Website - Next.js Application
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/bryan/projects/Orb_Weaver_Code_Website
Environment=NODE_ENV=production
Environment=PORT=41000
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
